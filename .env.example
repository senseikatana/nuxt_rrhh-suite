# PostgreSQL. En Neon usa la cadena *pooled* (con `-pooler`) y sslmode=require:
# postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# En Cloudflare Workers es obligatorio el endpoint `-pooler`: el driver serverless
# abre un WebSocket por conexión y sin pooling se agotan las conexiones de Neon.
# Nunca copies credenciales reales acá: usá variables de entorno del deploy.
DATABASE_URL=
# Aplicar migraciones pendientes al arrancar el servidor (true por defecto).
# Ponlo en false si migrás como paso del deploy (`bun run db:migrate`).
DB_AUTO_MIGRATE=true

# Autenticación (cambia el secreto en producción)
# BETTER_AUTH_SECRET se genera con `openssl rand -base64 48` y NUNCA se commitea.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Orígenes extra permitidos por better-auth (separados por coma)
BETTER_AUTH_TRUSTED_ORIGINS=
# Exigir email verificado para poder iniciar sesión
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Enviar email de verificación al registrarse
AUTH_SEND_VERIFICATION_ON_SIGNUP=false

# Almacenamiento de objetos compatible con S3 (Neon Storage).
# Se obtienen en Neon → Connect → Storage → pestaña `.env`.
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket por defecto si no se define: `assets`
S3_BUCKET=

# Email (SMTP corporativo). Si se deja vacío, los emails se registran en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RRHH Suite <rrhh@miempresa.com>"

# Asistente de contenido (gateway compatible con la API de OpenAI, p. ej. FreeLLMAPI).
# Sin AI_API_KEY el asistente queda desactivado y la app funciona con normalidad.
AI_BASE_URL=http://127.0.0.1:31415/v1
AI_API_KEY=
AI_MODEL=auto
